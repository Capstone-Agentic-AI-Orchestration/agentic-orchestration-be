// ─── Phase 2A: Agent Memory ────────────────────────────────────────────────────

model AgentMemory {
  id         String                      @id @default(cuid())
  /// Which agent produced this memory: frontend | backend | database | architecture | contract
  agentType  String
  /// Optional profile for future named agents; current runtime still keys by agentType.
  agentProfileId String?
  agentProfile AgentProfile?            @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)
  /// Controls whether a memory is private to an agent, shared by one project, or globally reusable.
  scope      AgentMemoryScope            @default(AGENT_PRIVATE)
  /// Partition key for similarity search scoping
  memoryType AgentMemoryType
  /// The raw text that was embedded (artifact content or summary)
  content    String                      @db.Text
  /// 1536-dim vector from text-embedding-3-small
  embedding  Unsupported("vector(1536)")
  /// Flexible metadata: stackKey, projectType, complexity, contractId, etc.
  metadata   Json                        @default("{}")
  /// Source project — nullable so global patterns survive project deletion
  projectId  String?
  sourceType String?
  importance Float                       @default(0.5)
  lastUsedAt DateTime?
  usageCount Int                         @default(0)
  expiresAt  DateTime?
  approvedAt DateTime?
  approvalSource String?
  createdAt  DateTime                    @default(now())

  @@index([agentType, memoryType])
  @@index([projectId])
  @@index([scope, projectId])
  @@index([agentType, scope, memoryType])
  @@index([agentType, projectId, scope])
  @@index([agentProfileId])
  @@index([approvedAt])
  @@map("agent_memories")
  @@schema("memory")
}

model AgentProfile {
  id          String        @id @default(cuid())
  slug        String        @unique
  displayName String
  role        String
  agentType   String
  modelHint   String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  memories    AgentMemory[]

  @@index([agentType, active])
  @@map("agent_profiles")
  @@schema("memory")
}

enum AgentMemoryScope {
  AGENT_PRIVATE
  PROJECT_CORE
  PROJECT_AGENT
  GLOBAL_PATTERN

  @@schema("memory")
}

enum AgentMemoryType {
  SKILL // successful agent prompt+output pairs that passed gate review
  PATTERN // fileManifest + contract that resulted in DELIVERED status
  MISTAKE // rejected artifacts with rejection notes

  @@schema("memory")
}

// ─── Phase 2B: Run Supervisor ──────────────────────────────────────────────────

model EventLog {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  /// Node name as defined in NODE constant (e.g. "backend_agent")
  nodeName   String
  /// Lifecycle transition: STARTED | COMPLETED | FAILED | RETRIED | STUCK | ESCALATED
  eventType  String
  /// Token counts: { inputTokens: number, outputTokens: number, model: string }
  costMeta   Json     @default("{}")
  /// Cumulative run-level token spend at the time of this event
  runTokens  Int      @default(0)
  occurredAt DateTime @default(now())

  @@index([projectId, occurredAt])
  @@map("event_logs")
  @@schema("orchestration")
}

model RunBudget {
  id             String   @id @default(cuid())
  projectId      String   @unique
  project        Project  @relation(fields: [projectId], references: [id])
  /// Hard token ceiling for this run (default: 200_000)
  tokenBudget    Int      @default(200000)
  /// Tokens consumed so far (charged by RunSupervisor on each node completion)
  tokensConsumed Int      @default(0)
  /// Number of automatic retries already executed
  retryCount     Int      @default(0)
  /// Max auto-retries before escalating to human
  maxRetries     Int      @default(2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("run_budgets")
  @@schema("orchestration")
}

