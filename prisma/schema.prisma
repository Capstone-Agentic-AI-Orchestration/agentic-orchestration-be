/// A thread. Owned by exactly one of a project or a client — never both, never neither.
///
/// It started out project-only, which put the project manager's conversation with a company
/// inside whichever project happened to be open at the time. That is the wrong home for it: the
/// relationship outlives any single build, so the second project the same company commissions
/// started its history from nothing while the first project's tab held everything that had ever
/// been said. Client-owned threads fix that; project-owned threads remain, because a developer
/// discussing one build genuinely does belong to that build.
///
/// Prisma cannot express "exactly one of these two columns", so the invariant is a CHECK
/// constraint — see 20260811000100_client_scoped_conversations.
model ProjectConversation {
  id            String                  @id @default(cuid())
  /// Set on a delivery thread: developers and the project manager, about one build.
  projectId     String?
  project       Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Set on a relationship thread: the project manager and the client company.
  clientId      String?
  client        Client?                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title         String
  category      ConversationCategory    @default(GENERAL)
  visibility    CollaborationVisibility @default(TEAM)
  createdById   String?                 @db.Uuid
  createdBy     Profile?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastMessageAt DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  messages      ProjectMessage[]
  reads         ConversationRead[]

  @@index([projectId, visibility, lastMessageAt])
  @@index([clientId, visibility, lastMessageAt])
  @@index([createdById])
  @@map("project_conversations")
  @@schema("collaboration")
}

model ProjectMessage {
  id             String              @id @default(cuid())
  /// Mirrors the owning conversation's projectId, and is therefore null on a client thread.
  ///
  /// Denormalised for project-scoped reporting only. Never filter a message list on it — scope is
  /// the conversation's business, and a query that also demands a projectId silently returns
  /// nothing for client threads. Read paths key on conversationId.
  projectId      String?
  conversationId String
  conversation   ProjectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?             @db.Uuid
  author         Profile?            @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body           String              @db.Text
  createdAt      DateTime            @default(now())

  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
  @@index([authorId])
  @@map("project_messages")
  @@schema("collaboration")
}

model ConversationRead {
  id             String              @id @default(cuid())
  conversationId String
  conversation   ProjectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String              @db.Uuid
  user           Profile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime            @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_reads")
  @@schema("collaboration")
}

