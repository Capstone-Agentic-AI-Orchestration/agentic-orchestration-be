  // Eve migration (Hybrid) — see docs/architecture/EVE_MIGRATION.md §6.4.
  // Serialized DevFlowState snapshot for the OrchestrationSequencer to persist run state and
  // resume after a gate pause. Null until a run has produced a checkpointed state.
  checkpointState     Json?
  // Immutable user-selected AI Gateway model snapshot for this run.
  // One default applies to all agents unless a specialist override is present.
  modelSelection      Json?
  error               String?                 @db.Text
  actorId             String?                 @db.Uuid
  intakeSnapshotId    String?
  intakeSnapshot      ProjectIntakeSnapshot?  @relation(fields: [intakeSnapshotId], references: [id], onDelete: SetNull)
  dispatchLabel       String?
  dispatchQueuedAt    DateTime?
  leaseOwner          String?
  leaseAcquiredAt     DateTime?
  leaseExpiresAt      DateTime?
  lastHeartbeatAt     DateTime?
  readyWorkOrders     Int                     @default(0)
