  @@index([agentType, active])
  @@map("agent_profiles")
  @@schema("memory")
}

enum AgentMemoryScope {
  AGENT_PRIVATE
  PROJECT_CORE
  PROJECT_AGENT
  GLOBAL_PATTERN

  @@schema("memory")
