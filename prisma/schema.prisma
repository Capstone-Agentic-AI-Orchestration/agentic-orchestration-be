generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  schemas      = ["admin", "collaboration", "identity", "intake", "integration", "memory", "notifications", "orchestration", "projects", "scheduling"]
  extensions   = [pgvector(map: "vector")]
  relationMode = "prisma"
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  ARCHIVED

  @@schema("projects")
}

/// An external client company. Distinct from Group, which is an internal delivery team.
///
/// Before this existed a client was only ever a free-text Project.companyName, so there was no
/// stable thing to hang a client page off and no way to tell that two projects belonged to the
/// same company. Project.clientId is intentionally nullable: an unlinked project is surfaced as
/// "unassigned" in the console rather than blocked at creation.
model Client {
  id                  String          @id @default(cuid())
  name                String
  status              ClientStatus    @default(ACTIVE)
  /// The team workspace that owns this client relationship.
  ///
  /// Clients used to be global: every workspace saw every company, which made the workspace
  /// switcher a lie for two of the three things it claims to scope. A client belongs to the
  /// team that sells to and delivers for it, and a project's workspace is now derived from
  /// its client rather than tracked separately.
  ///
  /// Required. Was nullable while the backfill ran: it infers a workspace from a client's
  /// existing projects, and a client with no projects had nothing to infer from. Those were
  /// assigned by a human rather than attached to an arbitrary team, and the state is now
  /// forbidden — see 20260807000700_client_requires_workspace.
  ///
  /// Restrict, not Cascade: deleting a workspace must not delete the companies it served.
  groupId             String
  group               Group           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  primaryContactName  String?
  primaryContactEmail String?
  notes               String?         @db.Text
  createdById         String?         @db.Uuid
  createdBy           Profile?        @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  projects            Project[]
  contacts            ClientContact[]
  inquiries           ClientInquiry[]
  /// Relationship threads with this company. Cascades: deleting a client is already blocked while
  /// it has projects, so this only ever fires for a company that never got past conversation.
  conversations       ProjectConversation[]

  @@index([status, name])
  @@index([createdById])
  @@index([groupId, name])
  @@map("clients")
  @@schema("projects")
}

/// A person who belongs to a client company.
///
/// This is a DIRECTORY relationship, not an access grant. Project access is still decided solely
/// by ProjectMember, so a contact can be listed here and still be unable to open any project —
/// the console must show that plainly rather than implying access it does not confer.
model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profileId String   @db.Uuid
  profile   Profile  @relation("ClientContactProfile", fields: [profileId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, profileId])
  @@index([profileId])
  @@map("client_contacts")
  @@schema("projects")
}

model Project {
  id                     String                  @id @default(cuid())
  companyName            String
  /// Every project belongs to a client company — the client comes first, always.
  ///
  /// This was nullable, which let a project exist with nobody to deliver it to. Two
  /// consequences followed: a whole "unassigned projects" mop-up screen had to exist, and any
  /// surface that reads through to the client had to treat its absence as normal. Requiring it
  /// removes the state rather than continuing to handle it.
  ///
  /// Restrict, not SetNull: nulling this out on client deletion is exactly the state the
  /// non-null constraint forbids, so a client with projects cannot be deleted at all.
  clientId               String
  client                 Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  brief                  String                  @db.Text
  stackKey               String
  status                 ProjectStatus           @default(PENDING)
  runId                  String?                 @unique
  repoUrl                String?
  groupId                String?
  group                  Group?                  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  repositories           Repository[]
  agentRepoSessions      AgentRepoSession[]
  createdById            String?                 @db.Uuid
  createdBy              Profile?                @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  version                Int                     @default(1)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  gates                  GateEvent[]
  artifacts              Artifact[]
  eventLogs              EventLog[]
  runBudget              RunBudget?
  members                ProjectMember[]
  tasks                  ProjectTask[]
  timelineEvents         ProjectTimelineEvent[]
  workOrders             WorkOrder[]
  conversations          ProjectConversation[]
  collaborationDocuments CollaborationDocument[]
  clientInvites          ClientInvite[]
  kickoff                ProjectKickoff?
  deliveryReview         ProjectDeliveryReview?
  intake                 ProjectIntake?
  intakeSnapshots        ProjectIntakeSnapshot[]
  orchestrationRuns      OrchestrationRun[]
  orchestrationJobs      OrchestrationJob[]
  providerInvocations    ProviderInvocation[]
  workOrderExecutions    WorkOrderExecution[]
  scheduleEvents         ScheduleEvent[]

  @@index([createdById])
  @@index([groupId])
  @@index([clientId])
  @@index([id, version])
  @@schema("projects")
}

enum InquiryStatus {
  /// A signed-in client is still working through the guided interview. Not yet anyone else's.
  ///
  /// Without this, a request entered the project manager's queue the moment the client clicked
  /// "Request a project" and then changed under them for the next ten minutes — and every
  /// abandoned conversation stayed there forever as a lead that was never actually sent.
  /// Every PM-facing read must exclude it.
  DRAFT
  NEW
  /// Accepted and in conversation with the client, but delivery has not started.
  IN_DISCOVERY
  APPROVED
  REJECTED

  @@schema("intake")
}

model ClientInquiry {
  id                String        @id @default(cuid())
  companyName       String
  contactName       String
  email             String
  phone             String?
  role              String?
  brief             String        @db.Text
  /// The structured brief, filled in by the guided agent before a project manager ever sees this.
  ///
  /// `brief` is what the client typed first; this is what the conversation turned it into — the
  /// same shape as ClientIntakePayload, so approval hands it straight to the project's intake
  /// rather than converting between two formats that would inevitably drift.
  ///
  /// Nullable because a lead can arrive from the marketing form with nothing but a sentence, and
  /// because the column is younger than the rows already in this table.
  payload           Json?
  stackKey          String        @default("nextjs-nestjs-supabase")
  budgetRange       String?
  timeline          String?
  status            InquiryStatus @default(NEW)
  reviewNote        String?       @db.Text
  reviewedById      String?       @db.Uuid
  reviewedBy        Profile?      @relation("InquiryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  approvedProjectId String?
  // Records which client this lead resolved to, so a second inquiry from the same company can
  // attach to the existing client instead of silently creating a duplicate.
  clientId          String?
  client            Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientInvite      ClientInvite?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([reviewedById])
  @@index([clientId])
  @@map("client_inquiries")
  @@schema("intake")
}

enum ClientInviteStatus {
  PENDING
  ACCEPTED
  REVOKED

  @@schema("intake")
}

enum ProjectKickoffStatus {
  DRAFT
  READY
  LOCKED

  @@schema("projects")
}

model ClientInvite {
  id           String             @id @default(cuid())
  inquiryId    String             @unique
  inquiry      ClientInquiry      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  projectId    String             @unique
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email        String
  contactName  String
  companyName  String
  status       ClientInviteStatus @default(PENDING)
  createdById  String?            @db.Uuid
  createdBy    Profile?           @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedById String?            @db.Uuid
  acceptedBy   Profile?           @relation("InviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([email, status])
  @@index([createdById])
  @@index([acceptedById])
  @@map("client_invites")
  @@schema("intake")
}

enum ProjectIntakeStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  READY
  LOCKED
  SUPERSEDED

  @@schema("intake")
}

enum DocumentExtractionStatus {
  PENDING
  EXTRACTING
  READY
  FAILED

  @@schema("intake")
}

model ProjectIntake {
  id            String                  @id @default(cuid())
  projectId     String                  @unique
  project       Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payload       Json                    @default("{}")
  status        ProjectIntakeStatus     @default(DRAFT)
  createdById   String?                 @db.Uuid
  createdBy     Profile?                @relation("ProjectIntakeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submittedById String?                 @db.Uuid
  submittedBy   Profile?                @relation("ProjectIntakeSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?
  reviewedById  String?                 @db.Uuid
  reviewedBy    Profile?                @relation("ProjectIntakeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote    String?                 @db.Text
  reviewedAt    DateTime?
  version       Int                     @default(1)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  comments      ProjectIntakeComment[]
  snapshots     ProjectIntakeSnapshot[]

  @@index([status, updatedAt])
  @@index([createdById])
  @@index([submittedById])
  @@index([reviewedById])
  @@map("project_intakes")
  @@schema("intake")
}

model ProjectIntakeComment {
  id          String        @id @default(cuid())
  intakeId    String
  intake      ProjectIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  section     String
  message     String        @db.Text
  resolvedAt  DateTime?
  createdById String?       @db.Uuid
  createdBy   Profile?      @relation("ProjectIntakeCommentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([intakeId, createdAt])
  @@index([createdById])
  @@map("project_intake_comments")
  @@schema("intake")
}

model ProjectIntakeSnapshot {
  id                String             @id @default(cuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  intakeId          String
  intake            ProjectIntake      @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  version           Int
  payload           Json
  contextPackage    Json
  pmNotes           String?            @db.Text
  lockedById        String?            @db.Uuid
  lockedBy          Profile?           @relation("ProjectIntakeLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  lockedAt          DateTime           @default(now())
  createdAt         DateTime           @default(now())
  orchestrationRuns OrchestrationRun[]

  @@unique([projectId, version])
  @@index([intakeId, createdAt])
  @@index([lockedById])
  @@map("project_intake_snapshots")
  @@schema("intake")
}

model ProjectKickoff {
  id                       String               @id @default(cuid())
  projectId                String               @unique
  project                  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scopeSummary             String?              @db.Text
  milestones               String?              @db.Text
  requiredDocuments        String?              @db.Text
  techStackNotes           String?              @db.Text
  deliveryRoles            String?              @db.Text
  readinessNotes           String?              @db.Text
  scopeConfirmed           Boolean              @default(false)
  milestonesConfirmed      Boolean              @default(false)
  documentsConfirmed       Boolean              @default(false)
  techStackConfirmed       Boolean              @default(false)
  rolesConfirmed           Boolean              @default(false)
  clientAccessConfirmed    Boolean              @default(false)
  initialTasksCreated      Boolean              @default(false)
  initialWorkOrdersCreated Boolean              @default(false)
  status                   ProjectKickoffStatus @default(DRAFT)
  completedById            String?              @db.Uuid
  completedBy              Profile?             @relation("KickoffCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt              DateTime?
  updatedById              String?              @db.Uuid
  updatedBy                Profile?             @relation("KickoffUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([status])
  @@index([completedById])
  @@index([updatedById])
  @@map("project_kickoffs")
  @@schema("projects")
}

model GateEvent {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id])
  gateType  GateType
  decision  GateDecision
  notes     String?      @db.Text
  decidedAt DateTime     @default(now())

  @@index([projectId])
  @@schema("projects")
}

model Artifact {
  id                     String                     @id @default(cuid())
  projectId              String
  project                Project                    @relation(fields: [projectId], references: [id])
  agentType              String
  filePath               String
  content                String                     @db.Text
  clientVisible          Boolean                    @default(false)
  displayName            String?
  sharedAt               DateTime?
  reviewStatus           ArtifactReviewStatus       @default(PENDING)
  reviewNote             String?                    @db.Text
  reviewedAt             DateTime?
  reviewedById           String?                    @db.Uuid
  outputReviewStatus     ArtifactOutputReviewStatus @default(PENDING)
  outputReviewNote       String?                    @db.Text
  outputReviewedAt       DateTime?
  outputReviewedById     String?                    @db.Uuid
  validationStatus       ArtifactValidationStatus   @default(PENDING)
  validationSummary      String?                    @db.Text
  validationErrors       Json                       @default("[]")
  publishedAt            DateTime?
  publishedById          String?                    @db.Uuid
  revisionHandledAt      DateTime?
  revisionHandledById    String?                    @db.Uuid
  revisionResolutionNote String?                    @db.Text
  source                 String?                    @default("llm")
  createdAt              DateTime                   @default(now())
  tasks                  ProjectTask[]
  workOrders             WorkOrder[]
  workOrderExecutions    WorkOrderExecution[]

  @@index([projectId])
  @@index([projectId, clientVisible])
  @@index([projectId, outputReviewStatus])
  @@index([projectId, validationStatus])
  @@schema("projects")
}

enum ArtifactReviewStatus {
  PENDING
  APPROVED
  REVISION_REQUESTED

  @@schema("projects")
}

enum ArtifactOutputReviewStatus {
  PENDING
  APPROVED
  REWORK_REQUESTED
  PUBLISHED

  @@schema("projects")
}

enum ArtifactValidationStatus {
  PENDING
  PASSED
  FAILED

  @@schema("projects")
}

enum ProjectStatus {
  /// Accepted lead, before any delivery work starts. The PM is still talking to the client and
  /// collecting documents; orchestration is refused until the project is promoted to PENDING.
  DISCOVERY
  PENDING
  PARSING_REQUIREMENTS
  NEGOTIATING_CONTRACT
  AWAITING_GATE_1
  GENERATING_CODE
  AWAITING_GATE_2
  COMMITTING
  DELIVERED
  FAILED

  @@schema("projects")
}

enum GateType {
  ARCHITECTURE_REVIEW
  CODE_REVIEW

  @@schema("projects")
}

enum GateDecision {
  APPROVED
  REJECTED

  @@schema("projects")
}

enum UserRole {
  CLIENT
  PM
  DEV
  ADMIN

  @@schema("identity")
}

enum ProfileStatus {
  /// Signed in, but not yet approved by a project manager. The auth guard refuses
  /// these accounts: they exist so the person can see their request status, nothing more.
  PENDING
  ACTIVE
  SUSPENDED

  @@schema("identity")
}

enum ScheduleEventType {
  MILESTONE
  MEETING
  DUE_DATE
  REMINDER
  OTHER

  @@schema("scheduling")
}

enum ScheduleVisibility {
  PRIVATE
  TEAM
  CLIENT

  @@schema("scheduling")
}

enum DeveloperAvailabilityStatus {
  AVAILABLE
  LIMITED
  UNAVAILABLE

  @@schema("identity")
}

/// Issue board columns.
///
/// Declared in board order, and the Postgres type is built in the same order, so `ORDER BY
/// status` sorts the way the board reads instead of alphabetically or by insertion accident.
enum ProjectTaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
  CANCELLED

  @@schema("projects")
}

model Profile {
  id                         String                  @id @db.Uuid
  email                      String?                 @unique
  fullName                   String?
  githubLogin                String?                 @unique
  avatarUrl                  String?
  role                       UserRole                @default(CLIENT)
  status                     ProfileStatus           @default(ACTIVE)
  preferences                Json                    @default("{}")
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  createdProjects            Project[]               @relation("ProjectCreatedBy")
  createdClients             Client[]                @relation("ClientCreatedBy")
  ownedWorkspaceAgents       WorkspaceAgent[]        @relation("WorkspaceAgentOwner")
  createdAgentSkills         AgentSkill[]            @relation("AgentSkillCreatedBy")
  clientContacts             ClientContact[]         @relation("ClientContactProfile")
  memberships                ProjectMember[]
  assignedTasks              ProjectTask[]           @relation("TaskAssignee")
  createdTasks               ProjectTask[]           @relation("TaskCreator")
  createdWorkOrders          WorkOrder[]             @relation("WorkOrderCreator")
  taskActivities             ProjectTaskActivity[]   @relation("TaskActivityActor")
  notifications              Notification[]          @relation("NotificationRecipient")
  sentNotifications          Notification[]          @relation("NotificationActor")
  timelineEvents             ProjectTimelineEvent[]  @relation("TimelineActor")
  createdConversations       ProjectConversation[]   @relation("ConversationCreator")
  messages                   ProjectMessage[]        @relation("MessageAuthor")
  messageReads               ConversationRead[]
  uploadedDocuments          CollaborationDocument[] @relation("DocumentUploader")
  reviewedDocuments          CollaborationDocument[] @relation("DocumentReviewer")
  createdIntakes             ProjectIntake[]         @relation("ProjectIntakeCreator")
  submittedIntakes           ProjectIntake[]         @relation("ProjectIntakeSubmitter")
  reviewedIntakes            ProjectIntake[]         @relation("ProjectIntakeReviewer")
  intakeComments             ProjectIntakeComment[]  @relation("ProjectIntakeCommentCreator")
  lockedIntakeSnapshots      ProjectIntakeSnapshot[] @relation("ProjectIntakeLocker")
  reviewedInquiries          ClientInquiry[]         @relation("InquiryReviewer")
  createdClientInvites       ClientInvite[]          @relation("InviteCreator")
  acceptedClientInvites      ClientInvite[]          @relation("InviteAcceptor")
  completedKickoffs          ProjectKickoff[]        @relation("KickoffCompleter")
  updatedKickoffs            ProjectKickoff[]        @relation("KickoffUpdater")
  acceptedDeliveries         ProjectDeliveryReview[] @relation("DeliveryAcceptor")
  requestedDeliveryRevisions ProjectDeliveryReview[] @relation("DeliveryRevisionRequester")
  resolvedDeliveryRevisions  ProjectDeliveryReview[] @relation("DeliveryRevisionResolver")
  scheduleEvents             ScheduleEvent[]         @relation("ScheduleOwner")
  developerProfile           DeveloperProfile?
  adminAuditLogs             AdminAuditLog[]         @relation("AdminAuditActor")
  ownedGroups                Group[]                 @relation("GroupOwner")
  groupMemberships           GroupMember[]           @relation("GroupMembershipUser")
  groupInvitations           GroupInvitation[]       @relation("GroupInvitationRecipient")
  sentGroupInvitations       GroupInvitation[]       @relation("GroupInvitationSender")
  createdRepositories        Repository[]            @relation("RepositoryCreator")
  repositoryAssignments      RepositoryAssignment[]  @relation("RepositoryAssignmentUser")
  assignedRepositoryAccess   RepositoryAssignment[]  @relation("RepositoryAssignmentActor")
  groupActivityEvents        GroupActivityEvent[]    @relation("GroupActivityActor")

  @@index([role])
  @@index([status])
  @@map("profiles")
  @@schema("identity")
}

model ScheduleEvent {
  id          String             @id @default(cuid())
  title       String
  description String?            @db.Text
  startsAt    DateTime
  endsAt      DateTime?
  type        ScheduleEventType  @default(MEETING)
  visibility  ScheduleVisibility @default(TEAM)
  projectId   String?
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId     String             @db.Uuid
  owner       Profile            @relation("ScheduleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([ownerId, startsAt])
  @@index([projectId, startsAt])
  @@index([visibility, startsAt])
  @@map("schedule_events")
  @@schema("scheduling")
}

model DeveloperProfile {
  userId              String                      @id @db.Uuid
  user                Profile                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills              Json                        @default("[]")
  weeklyCapacityHours Int                         @default(40)
  availabilityStatus  DeveloperAvailabilityStatus @default(AVAILABLE)
  notes               String?                     @db.Text
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([availabilityStatus])
  @@map("developer_profiles")
  @@schema("identity")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String   @db.Uuid
  role      UserRole
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
  @@map("project_members")
  @@schema("projects")
}

enum GroupRole {
  LEAD
  DELEGATED_LEAD
  MEMBER
  VIEWER

  @@schema("projects")
}

enum GroupLifecycleStatus {
  ACTIVE
  ARCHIVED

  @@schema("projects")
}

enum GroupMemberStatus {
  ACTIVE
  REMOVED

  @@schema("projects")
}

enum GroupInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED

  @@schema("projects")
}

enum RepositoryStatus {
  PENDING
  ACTIVE
  FAILED
  ARCHIVED

  @@schema("projects")
}

enum RepositoryKind {
  BACKEND
  FRONTEND
  MOBILE

  @@schema("projects")
}

enum RepositoryAssignmentDesiredState {
  ASSIGNED
  UNASSIGNED

  @@schema("projects")
}

enum RepositoryAssignmentEffectiveState {
  PENDING
  ACTIVE
  REVOKING
  REVOKED
  FAILED

  @@schema("projects")
}

model Group {
  id                   String               @id @default(cuid())
  name                 String
  description          String?              @db.Text
  businessUnit         String?
  status               GroupLifecycleStatus @default(ACTIVE)
  ownerId              String               @db.Uuid
  owner                Profile              @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  githubInstallationId String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  members              GroupMember[]
  invitations          GroupInvitation[]
  projects             Project[]
  clients              Client[]
  repositories         Repository[]
  activityEvents       GroupActivityEvent[]
  workspaceAgents      WorkspaceAgent[]
  agentSkills          AgentSkill[]

  @@index([ownerId, status])
  @@index([githubInstallationId])
  @@map("groups")
  @@schema("projects")
}

model GroupMember {
  id        String            @id @default(cuid())
  groupId   String
  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String            @db.Uuid
  user      Profile           @relation("GroupMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  role      GroupRole         @default(MEMBER)
  status    GroupMemberStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([groupId, userId])
  @@index([userId, status])
  @@index([groupId, role, status])
  @@map("group_members")
  @@schema("projects")
}

model GroupInvitation {
  id            String                @id @default(cuid())
  groupId       String
  group         Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedUserId String                @db.Uuid
  invitedUser   Profile               @relation("GroupInvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedById   String                @db.Uuid
  invitedBy     Profile               @relation("GroupInvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  role          GroupRole             @default(MEMBER)
  status        GroupInvitationStatus @default(PENDING)
  respondedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([groupId, invitedUserId])
  @@index([invitedUserId, status, createdAt])
  @@index([invitedById])
  @@index([groupId, status])
  @@map("group_invitations")
  @@schema("projects")
}

model Repository {
  id            String                 @id @default(cuid())
  groupId       String
  group         Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind          RepositoryKind         @default(BACKEND)
  stack         String?
  name          String
  fullName      String?                @unique
  htmlUrl       String?
  cloneUrl      String?
  defaultBranch String                 @default("main")
  visibility    String                 @default("private")
  status        RepositoryStatus       @default(PENDING)
