enum AgentAccessScope {
  /// Visible to and usable by everyone in the team workspace.
  WORKSPACE
  /// Visible only to the profile that owns it.
  PERSONAL

  @@schema("orchestration")
}

enum WorkspaceAgentStatus {
  ACTIVE
  ARCHIVED

  @@schema("orchestration")
}

/// A configurable orchestration agent.
///
/// The console used to render the agent roster from a hand-maintained TypeScript constant that
/// mirrored `agentic-orchestration-ag/agent/subagents`. It could drift silently and nothing on
/// the page could be changed. This is the same roster as editable records: the twelve built-ins
/// are seeded per workspace and their `instructions` override the compiled-in system prompt at
/// dispatch, so editing one changes what the agent is actually told on the next run.
///
/// `key` is the dispatch identity the orchestration knows an agent by ('frontend', 'qa', ...).
/// Built-ins keep the package's key; custom agents get a generated one. It is unique per
/// workspace, so two teams can each tune their own frontend agent without colliding.
model WorkspaceAgent {
  id           String             @id @default(cuid())
  key          String
  /// Which deployed Eve subagent executes this agent.
  ///
  /// `key` is identity — what a workspace names and configures. `runtimeKey` is capability —
  /// which deployed directory carries the tools and the self-repair loop. The two coincide for
  /// built-ins, which is exactly what hid the distinction: a custom agent has an identity with
  /// no directory behind it, and so could never be dispatched.
  ///
  /// Null means "same as key", so existing rows keep working with no backfill.
  runtimeKey   String?
  name         String
  description  String?            @db.Text
  avatarEmoji  String?
  /// Overrides the compiled-in system prompt. Null means "use the built-in", which is why it is
  /// nullable rather than seeded with a copy — a copy would freeze the prompt at seed time and
  /// silently diverge from the package every time the built-in is improved.
  instructions String?            @db.Text
  /// Gateway model id. Null means the run's default model applies.
  model        String?
  concurrency  Int                @default(1)
  accessScope  AgentAccessScope   @default(WORKSPACE)
  status       WorkspaceAgentStatus @default(ACTIVE)
  /// Seeded from the agent package. Editable and archivable, never deletable: the pipeline
  /// dispatches these by key and deleting one would break runs rather than tidy the list.
  isBuiltIn    Boolean            @default(false)
  groupId      String
  group        Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ownerId      String?            @db.Uuid
  owner        Profile?           @relation("WorkspaceAgentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  skills       AgentSkillOnAgent[]
  workOrders   WorkOrder[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([groupId, key])
  @@index([groupId, status, name])
  @@index([ownerId])
  @@map("workspace_agents")
  @@schema("orchestration")
}

/// A reusable Markdown skill, authored once and attachable to many agents.
///
/// Workspace-global on purpose: a convention worth teaching one agent is almost always worth
/// teaching its neighbours, and duplicating the text per agent guarantees the copies drift.
/// `body` is Markdown and is appended to the system prompt of every agent it is attached to, so
/// a skill is a functional instruction fragment rather than documentation about one.
model AgentSkill {
  id          String              @id @default(cuid())
  slug        String
  name        String
  description String?             @db.Text
  body        String              @db.Text
  groupId     String
  group       Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById String?             @db.Uuid
  createdBy   Profile?            @relation("AgentSkillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  agents      AgentSkillOnAgent[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([groupId, slug])
  @@index([groupId, name])
  @@index([createdById])
  @@map("agent_skills")
  @@schema("orchestration")
}

model AgentSkillOnAgent {
  id        String       @id @default(cuid())
  agentId   String
  agent     WorkspaceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillId   String
  skill     AgentSkill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([agentId, skillId])
  @@index([skillId])
  @@map("agent_skill_on_agent")
  @@schema("orchestration")
}
