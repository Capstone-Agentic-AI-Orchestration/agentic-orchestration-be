/// A short-lived capability granting one agent turn read/write access to exactly one
/// project's repositories.
///
/// The agent service (agentic-orchestration-ag) holds no GitHub credentials. It calls back
/// into this backend with the opaque `token`, which resolves to a projectId here — so
/// repository scope is enforced server-side against the database, never from a value the
/// model produced. Tokens are single-run, time-boxed, and revocable.
model AgentRepoSession {
  id         String    @id @default(cuid())
  token      String    @unique
  runId      String
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Branch every write from this turn lands on; never the default branch.
  branch     String
  agentType  String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  useCount   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([projectId])
  @@index([runId])
  @@index([expiresAt])
  @@map("agent_repo_sessions")
  @@schema("orchestration")
}

