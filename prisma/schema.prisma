model WorkOrder {
  id                   String               @id @default(cuid())
  projectId            String
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId               String?
  task                 ProjectTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  artifactId           String?
  artifact             Artifact?            @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  title                String
  instructions         String?              @db.Text
  /// What kind of file this work order must produce.
  ///
  /// Kept alongside `workspaceAgentId` because the two answer different questions: `agentType` is
  /// the OUTPUT contract — required extensions, language, and the signals the validator checks —
  /// while the agent is who does the work and how. A custom agent still has to declare what it
  /// will produce, so this stays required.
  agentType            WorkOrderAgentType
  /// The configured agent assigned to this work order.
  ///
  /// Null keeps the previous behaviour, where the role text is derived from `agentType` alone.
  /// Set, it is the path by which a workspace's own agent — its instructions, its skills, its
  /// runtime — actually executes something. SetNull rather than Cascade: deleting an agent must
  /// not delete the record of work it did.
  workspaceAgentId     String?
  workspaceAgent       WorkspaceAgent?      @relation(fields: [workspaceAgentId], references: [id], onDelete: SetNull)
  status               WorkOrderStatus      @default(DRAFT)
  priority             WorkOrderPriority    @default(NORMAL)
  createdById          String?              @db.Uuid
  createdBy            Profile?             @relation("WorkOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  executionRunId       String?
  executionAttempt     Int                  @default(0)
  executionStartedAt   DateTime?
  executionCompletedAt DateTime?
  executionError       String?              @db.Text
  lastEventAt          DateTime?
  dispatchedAt         DateTime?
  completedAt          DateTime?
  failedAt             DateTime?
  version              Int                  @default(1)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  executions           WorkOrderExecution[]
  runtimeTasks         RuntimeTask[]

  @@index([projectId, status])
  @@index([taskId])
  @@index([artifactId])
  @@index([createdById])
  @@index([executionRunId])
  @@index([status, lastEventAt])
  @@index([id, version])
  @@map("work_orders")
  @@schema("orchestration")
}

