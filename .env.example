# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://devflow:devflow@localhost:5432/devflow"
# Direct (non-pooled) connection used by Prisma for migrations / db push.
# In local development this can match DATABASE_URL.
# On Supabase, DATABASE_URL is the pgbouncer pooler (port 6543) and DIRECT_URL is the
# direct connection (port 5432). Prisma's datasource references this via directUrl.
DIRECT_URL="postgresql://devflow:devflow@localhost:5432/devflow"
SUPABASE_URL="https://your-project-ref.supabase.co"
# Release/CI only. Used by npm run verify:supabase-schema through the Supabase Management API.
SUPABASE_PROJECT_REF=""
SUPABASE_ACCESS_TOKEN=""
# Optional, server-side only. Used by npm run seed:demo to create demo auth users.
SUPABASE_SERVICE_ROLE_KEY=""
# Optional fallback for npm run seed:demo when service-role access is unavailable and public signup is enabled.
SUPABASE_ANON_KEY=""

# ─────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────
# DevFlow verifies Supabase access tokens, then restricts which upstream
# Supabase auth providers are allowed to reach protected role-based APIs.
# Production GitHub-only setup: AUTH_ALLOWED_PROVIDERS="github"
# Future GitHub + Google setup: AUTH_ALLOWED_PROVIDERS="github,google"
# Local password demos only: AUTH_ALLOWED_PROVIDERS="email,github"
AUTH_ALLOWED_PROVIDERS="github"

# Optional demo seed overrides.
# DEMO_PROJECT_ID="demo-persona-project"
# DEMO_PM_EMAIL="devflow.pm@example.com"
# DEMO_DEV_EMAIL="devflow.dev@example.com"
# DEMO_CLIENT_EMAIL="devflow.client@example.com"
# DEMO_AUTH_PASSWORD="DevFlowDemo123!"

# ─────────────────────────────────────────────
# AI Models
# ─────────────────────────────────────────────
# mock runs the local deterministic agent provider and does not require AI keys.
# Use llm only when a supported provider API key is configured.
AGENT_PROVIDER="mock"

# --- Eve --- see docs/architecture/EVE_MIGRATION.md
# Selects how agent nodes generate code:
#   "eve" (canonical/default): delegate generation to the Eve agent service (sandbox typecheck + self-repair)
#   "direct"                : in-process raw-fetch provider using LLM_PROVIDER
#   "graph"                 : deprecated alias for "direct"; accepted for one release
# When "eve" but EVE_SERVICE_URL is unset or preflight-unavailable before a run starts,
# the router falls back to "direct" explicitly. It does not silently switch engines mid-turn.
ORCHESTRATION_LLM_ENGINE="eve"
# Runs are dispatched asynchronously after the API writes run state.
# "db-lease" is the durable restart-safe mode. "in-process" is local/dev compatibility only.
ORCHESTRATION_DISPATCHER_MODE="db-lease"
# Base URL of the deployed agentic-orchestration-ag service (required to actually use the Eve engine).
EVE_SERVICE_URL=""
# Bearer token for the Eve service route-auth secret (optional).
EVE_SERVICE_TOKEN=""
# Model the Eve agents resolve through Vercel AI Gateway (optional; subagents default to this).
EVE_MODEL="openai/gpt-5.4-mini"

LLM_PROVIDER="openrouter"
LLM_REQUEST_TIMEOUT_MS=120000
LLM_CONCURRENCY_LIMIT=4
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="deepseek/deepseek-v4-flash:free"
OPENROUTER_FALLBACK_MODEL="nvidia/nemotron-3-nano-30b-a3b:free"
# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL="http://localhost:4000"
OPENROUTER_APP_NAME="DevFlow"

# Alternate real provider. Set LLM_PROVIDER="openai" to use this path.
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_FALLBACK_MODEL=""
OPENAI_API_KEY=""

# OpenCode Go uses an OpenAI-compatible endpoint. For OpenCode-only backend agents, set
# ORCHESTRATION_LLM_ENGINE="direct" and LLM_PROVIDER="opencode".
OPENCODE_BASE_URL="https://opencode.ai/zen/go/v1"
OPENCODE_MODEL="deepseek-v4-flash"
OPENCODE_FALLBACK_MODEL="deepseek-v4-pro"
OPENCODE_API_KEY=""

# Alternate real provider. Set LLM_PROVIDER="anthropic" to use this path.
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
ANTHROPIC_MODEL="claude-3-5-haiku-20241022"
ANTHROPIC_FALLBACK_MODEL=""
ANTHROPIC_VERSION="2023-06-01"
ANTHROPIC_API_KEY=""

# Gemini uses Google's OpenAI-compatible endpoint. Set LLM_PROVIDER="gemini" to use this path.
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODEL=""
GEMINI_API_KEY=""

# ─────────────────────────────────────────────
# GitHub App credentials (server-to-server: pushing code artifacts to repos)
# One App per environment: agentic-orchestration-{test,uat,main}.
# Generate these with: setup/github/create-github-app.mjs  (see setup/github/README.md)
# The private key may be base64-encoded from the PEM file:
#   base64 -w 0 your-app.private-key.pem
# Raw PEM and escaped-newline PEM values are also normalized at runtime.
# ─────────────────────────────────────────────
GITHUB_APP_ID="123456"
GITHUB_APP_SLUG="agentic-orchestration-main"
# Recommended: encode your .pem file: base64 -w 0 your-app.private-key.pem
GITHUB_PRIVATE_KEY="<base64-encoded PEM key>"
GITHUB_INSTALLATION_ID="12345678"
GITHUB_ORG="Capstone-Agentic-AI-Orchestration"
# Org team slugs that map a GitHub login to a DevFlow role at first sign-in.
# A login in the PM team becomes PM, the dev team becomes DEV; otherwise CLIENT.
# Requires the GitHub App to have `Members: read` org permission.
# Leave blank to disable team-based role mapping.
GITHUB_DEV_TEAM=""
GITHUB_PM_TEAM=""
# Optional — populated by the App creator; used only if you enable webhooks/OAuth-on-App.
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# GitHub OAuth App (user "Sign in with GitHub") is NOT configured here.
# Auth runs through Supabase, so the OAuth Client ID/Secret go in the Supabase
# dashboard (Authentication → Providers → GitHub), not in this backend .env.

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
# Restrict in production: CORS_ORIGIN="https://your-frontend.com"
CORS_ORIGIN="*"

# ─────────────────────────────────────────────
# LangSmith (Phase 2E — enable for observability)
# ─────────────────────────────────────────────
LANGCHAIN_API_KEY="ls__..."
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_PROJECT="devflow"

# ─────────────────────────────────────────────
# Phase 2B — RunSupervisor
# ─────────────────────────────────────────────
# SUPERVISOR_POLL_INTERVAL_MS=30000      # How often supervisor polls for stuck runs
# SUPERVISOR_STUCK_THRESHOLD_MS=300000   # A run is "stuck" if no event logged in this window

# ─────────────────────────────────────────────
# Transactional outbox relay (optional)
# ─────────────────────────────────────────────
OUTBOX_RELAY_ENABLED="false"
OUTBOX_RELAY_INTERVAL_MS=10000
OUTBOX_RELAY_BATCH_SIZE=25
OUTBOX_RELAY_LOCK_MS=60000
OUTBOX_RELAY_MAX_ATTEMPTS=5
